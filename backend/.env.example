# ============================================================
# NEXUS AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── LLM Provider ──────────────────────────────────────────────
# Choose: openai | huggingface | mock
LLM_PROVIDER=openai

# OpenAI (recommended)
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# HuggingFace (alternative)
HUGGINGFACE_API_KEY=hf_your-huggingface-key-here

# ── Embeddings & Vector DB ────────────────────────────────────
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB=faiss
CHROMA_PERSIST_DIR=./data/chroma

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/research_assistant.db

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
REPORTS_DIR=./data/reports

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Add your deployed frontend URL here:
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# ── Agent Settings ────────────────────────────────────────────
MAX_REFLECTION_LOOPS=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production
MAX_FILE_SIZE_MB=50

# ── Redis (optional) ──────────────────────────────────────────
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
